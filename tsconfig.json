{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "composite": true,
    "paths": {
      "@components/*": ["./components/*"],
      "@utils/*": ["./utils/*"],
      "@defaultElements/*": ["./components/atoms/defaultElements/*"],
      "@layout/*": ["./layout/*"],
      "@services/*": ["./services/*"],
      "@HOC/*": ["./HOC/*"],
      "@asset/*": ["./public/assets/*"],
      "@redux/*": ["./store/*"],
      "@type/*": ["./types/*"],
      "@public/*": ["./public/*"],
      "@slice/*": ["./slice/*"],
      "@store/*": ["./store/*"],
      "@styles/*": ["./styles/*"],
      "@hooks/*": ["./hooks/*"],
      "@constants/*": ["./constants/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "GlobalTypes.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.json",
    "**/*.css",
    "**/*.woff",
    "**/*.eot",
    "**/*.ttf",
    "**/*.svg",
    "**/*.ico",
    "**/*.png",
    ".next/types/**/*.ts",
    "dynamsoft.config.ts",
    "components/organisms/erp-table/ui/erp-table/ERPTableHeader.فسط"
, "components/templates/access/account/defaultDescriptionsConfig.tsx"  ],
  "exclude": ["node_modules"]
}
