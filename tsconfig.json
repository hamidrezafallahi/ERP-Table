{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "persian-data-grid/plugins/excel": ["./publish/plugins/excel.ts"],
      "persian-data-grid/plugins/pdf": ["./publish/plugins/pdf.ts"],
      "persian-data-grid/plugins/pdf/fonts/vazirmatn": [
        "./publish/plugins/pdf-fonts-vazirmatn.ts"
      ],
      "persian-data-grid/adapters/arian-erp": ["./publish/adapters/arian-erp.ts"],
      "persian-data-grid/headless": ["./publish/headless.ts"]
    }
  },
  "include": [
    "publish/**/*.ts",
    "publish/**/*.tsx",
    "application/**/*.ts",
    "bootstrap/**/*.ts",
    "domain/**/*.ts",
    "engine/**/*.ts",
    "infrastructure/**/*.ts",
    "packages/plugins/**/*.ts",
    "types/**/*.d.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/__tests__/**"
  ]
}
