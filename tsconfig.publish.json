{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "publish/**/*.ts",
    "application/**/*.ts",
    "bootstrap/**/*.ts",
    "domain/**/*.ts",
    "engine/**/*.ts",
    "infrastructure/**/*.ts",
    "packages/plugins/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/__tests__/**",
    "ui/useERPGrid.ts",
    "ui/cellRenderer/descriptionComponent/useVoucherDescription.tsx"
  ]
}
