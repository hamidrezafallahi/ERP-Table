{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "persian-data-grid": ["../../publish/entry.ts"],
      "persian-data-grid/headless": ["../../publish/headless.ts"],
      "persian-data-grid/presence": ["../../publish/presence.ts"],
      "persian-data-grid/sync": ["../../publish/sync.ts"],
      "persian-data-grid/styles.css": ["../../ui/styles/erp-table.css"],
      "persian-data-grid/plugins/excel": ["../../publish/plugins/excel.ts"],
      "persian-data-grid/plugins/csv": ["../../publish/plugins/csv.ts"],
      "persian-data-grid/plugins/pdf": ["../../publish/plugins/pdf.ts"],
      "persian-data-grid/plugins/pdf/fonts/vazirmatn": ["../../publish/plugins/pdf-fonts-vazirmatn.ts"],
      "persian-data-grid/date-picker-jalali": ["../../publish/date-picker-jalali.ts"],
      "persian-data-grid/finance": ["../../publish/finance.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
