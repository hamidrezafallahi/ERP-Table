{
  "name": "persian-data-grid",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "hamidreza fallahi",
  "keywords": [
    "persian-data-grid",
    "data-grid",
    "data grid",
    "react-data-grid",
    "react table",
    "headless-data-grid",
    "erp",
    "erp grid",
    "event-sourcing",
    "cqrs",
    "indexeddb",
    "offline-first",
    "excel-like",
    "keyboard-navigation",
    "virtual-scroll",
    "rtl",
    "persian",
    "jalali",
    "shamsi",
    "ddd",
    "typescript",
    "react"
  ],
  "description": "Persian / Jalali data grid for React — event-sourced, IndexedDB storage, Excel/IDE keyboard navigation, RTL, reactive cells that call your API. TypeScript, virtual scroll, Excel/PDF plugins.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamidrezafallahi/ERP-Table.git"
  },
  "bugs": {
    "url": "https://github.com/hamidrezafallahi/ERP-Table/issues"
  },
  "homepage": "https://hamidrezafallahi.github.io/ERP-Table/",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts --mode playground",
    "dev:docs": "vite --config demo/vite.config.ts",
    "dev:demo": "vite --config demo/vite.config.ts",
    "dev:playground": "vite --config demo/vite.config.ts --mode playground",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview:demo": "vite preview --config demo/vite.config.ts",
    "deploy:demo": "gh-pages -d demo/dist",
    "test": "vitest run domain/__tests__ application/__tests__ infrastructure/__tests__ bootstrap/__tests__ engine/__tests__ ui/virtual/__tests__ ui/desktop/__tests__ ui/cellRenderer/__tests__ ui/keyboard/__tests__ ui/gridSearch/__tests__ ui/styles/__tests__ ui/theme/__tests__ docs/__tests__ packages/plugins/excel/__tests__ packages/plugins/pdf/__tests__",
    "typecheck:publish": "tsc -p tsconfig.publish.json --noEmit",
    "typecheck:host-ui": "tsc -p tsconfig.json --noEmit",
    "build": "tsup --config tsup.config.ts",
    "verify:dist": "node ./scripts/verify-dist.mjs",
    "prepublishOnly": "npm run typecheck:publish && npm run typecheck:host-ui && npm run build && npm run verify:dist && npm test"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "gh-pages": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "react-persian-range-picker": "^1.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react-persian-range-picker": "^1.1.1"
  }
}
